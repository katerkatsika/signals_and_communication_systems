        <mxCell id="0HuFGXYE05QS9Vd9-05A-34" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ \frac{Α_c}{2} \cdot J_{1}(\beta) =&amp;nbsp;&amp;nbsp;&amp;nbsp;\frac{Α_c}{2} \cdot J_{2}(\beta) \space \Rightarrow \\ \\&amp;nbsp; J_{1}(\beta) = J_{2}(\beta) =$$" vertex="1">
