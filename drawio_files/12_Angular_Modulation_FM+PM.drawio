        <mxCell id="oRfMEREpWaWhYflUV6nL-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ BW = 2 \space f_m \space (\beta + 1)&amp;nbsp; \space \Rightarrow \\ \\ BW = 2 \space \frac{200}{\pi} \cdot (6 + 1) \space \Rightarrow \space BW = 2800 / \pi&amp;nbsp; \space \text{ [Hz]} $$" vertex="1">
