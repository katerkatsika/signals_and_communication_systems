        <mxCell id="OOeB8Bl85kDXnF0w7lMu-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ s(t) = A_c \space cos\Bigg[ 2 \pi f_c \space t&amp;nbsp; + 2 \pi \space K_f&amp;nbsp; \int_{0}^{t} m(\tau) \space d \tau \Bigg] \space \Rightarrow&amp;nbsp; \\ \\ s(t) = A_c \space cos \Bigg[ 2 \pi f_c \space t&amp;nbsp; + 2 \pi \space K_f \int_{0}^{t} A_m \cdot cos (2 \pi f_m \space \tau) \space d \tau&amp;nbsp; \Bigg] \space \Rightarrow \\ \\ s(t) = A_c \space cos \Bigg[ 2 \pi f_c \space t&amp;nbsp; + \frac{2 \pi \space K_f A_m}{2 \pi \space f_m} \cdot \big[ sin (2 \pi f_m \space \tau) \big]_{0}^{t}&amp;nbsp; \Bigg]&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; s(t) = A_c \cdot cos \Bigg[ 2 \pi f_c \space t + \frac{K_f A_m}{f_m} \cdot sin (2 \pi f_m \space t)&amp;nbsp; &amp;nbsp;\Bigg]$$" vertex="1">
