        <mxCell id="7TuqR_EnMW4ri-_Q-CD0-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Οπότε:" vertex="1">
          <mxGeometry height="23" width="50" x="-240" y="714" as="geometry" />
        </mxCell>
        <mxCell id="-GxXnwEKhlJVIfIBBDvO-1" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#000000,#FFFF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="56" width="275" x="-164" y="848" as="geometry" />
        </mxCell>
        <mxCell id="-GxXnwEKhlJVIfIBBDvO-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ u(t) = A_c \space cos\Bigg[ 2 \pi f_c \space t&amp;nbsp; + 2 \pi \space K_f&amp;nbsp; \int_{0}^{t} m(\tau) \space d \tau \Bigg] \space \Rightarrow \\ \\ u(t) = 100 \space cos \Bigg[ 2 \pi f_c \space t&amp;nbsp; + 2 \pi \cdot \frac{120}{\pi} \int_{0}^{t} 10 \cdot sinc (400 \space \tau) \space d \tau&amp;nbsp; \Bigg]&amp;nbsp; \space \Rightarrow \\ \\ u(t) = 100 \space cos \Bigg[ 2 \pi f_c \space t&amp;nbsp; + 2400 \int_{0}^{t} sinc (400 \space \tau) \space d \tau&amp;nbsp; \Bigg] $$" vertex="1">
          <mxGeometry height="167" width="344" x="-199" y="737" as="geometry" />
        </mxCell>
        <mxCell id="-GxXnwEKhlJVIfIBBDvO-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 242, 204));&quot;&gt;2) Ποια είναι η μέγιστη απόκλιση συχνότητας του διαμορφωμένου&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 242, 204));&quot;&gt;FM&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 242, 204));&quot;&gt;&amp;nbsp;σήματος;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="23" width="435" x="-280" y="940" as="geometry" />
        </mxCell>
        <mxCell id="-GxXnwEKhlJVIfIBBDvO-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;Μέγιστη απόκλιση:&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="23" width="117.5" x="-245" y="980" as="geometry" />
        </mxCell>
        <mxCell id="LiZD6EoEZpDpiX_9Zuoe-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ \Delta f = K_f \cdot A_m&amp;nbsp; = \beta \cdot f_m&amp;nbsp; \space \Rightarrow \\ \\ \Delta f = \frac{6 \cdot 200}{\pi} \space \Rightarrow \space \Delta f = 1200 / \pi $$" vertex="1">
          <mxGeometry height="70" width="200" x="-120" y="1003" as="geometry" />
        </mxCell>
        <mxCell id="TVsFIOziox3_uR0mdxGN-1" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#000000,#FFFF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="36" width="82.5" x="-11" y="1037" as="geometry" />
        </mxCell>
        <mxCell id="TVsFIOziox3_uR0mdxGN-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 242, 204));&quot;&gt;3) Ποια είναι η ισχύς του διαμορφωμένου σήματος&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 242, 204));&quot;&gt;FM;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="23" width="300" x="-280" y="1113" as="geometry" />
        </mxCell>
        <mxCell id="TVsFIOziox3_uR0mdxGN-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ P_{FM} = \frac{A^2_c}{2} = \frac{100^2}{2} = \frac{10000}{2} \space \Rightarrow \\ \\ P_{FM} = 5000 \space \text{ [Watt]}$$" vertex="1">
