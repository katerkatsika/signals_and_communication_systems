        <mxCell id="3N1-DfVV0ElVK-WVgR2o-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ F_1 = \frac{A_c}{2} \space \delta (f - f_c) + \frac{A_c}{2} \space \delta (f + f_c) $$" vertex="1">
