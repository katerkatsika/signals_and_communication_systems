          <mxGeometry height="23" width="415" x="-280" y="560" as="geometry" />
        </mxCell>
        <mxCell id="K7y4DSUFWtWCGQQQVLmO-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ \beta = \frac{K_f \cdot A_m}{f_m} \space \Rightarrow \space K_f = \frac{\beta \cdot f_m}{A_m} \space \Rightarrow \\ \\ K_f = \frac{6 \cdot \frac{200}{\pi}}{10} \space \Rightarrow \space K_f = \frac{120}{\pi}$$" vertex="1">
