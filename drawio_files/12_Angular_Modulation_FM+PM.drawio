        <mxCell id="0HuFGXYE05QS9Vd9-05A-40" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$&amp;nbsp; \beta = \frac{K_f \cdot A_m}{f_m}&amp;nbsp;&amp;nbsp;\space \Rightarrow \space A_m = \frac{\beta \cdot f_m}{K_f} \space \Rightarrow \space A_m =&amp;nbsp; \frac{2.6 \cdot 0.05}{0.2} \space \Rightarrow \space A_m = 0.65 \space \text{ [Volt]}$$" vertex="1">
