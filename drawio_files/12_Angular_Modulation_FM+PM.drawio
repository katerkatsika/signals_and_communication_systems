        <mxCell id="3N1-DfVV0ElVK-WVgR2o-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="Έχουμε θέσει:" vertex="1">
          <mxGeometry height="21.73" width="80" x="-280.6" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="3N1-DfVV0ElVK-WVgR2o-18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ x(t) = \int_{0}^{t} m(\tau) \space d \tau&amp;nbsp; \space \Rightarrow \space&amp;nbsp; \frac{dx}{dt} = m(t)&amp;nbsp; \space \Rightarrow \space F \Bigg \{ \frac{dx}{dt} \Bigg \} = F \Bigg \{ m(t) \Bigg \} $$" vertex="1">
