        <mxCell id="6sSz4_p9k6nHnBbuacPH-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ S_{_{NBFM}}(f) = F \Bigg \{A_c&amp;nbsp; \space cos (2 \pi f_c \space t) \Bigg \} - F \Bigg \{&amp;nbsp;&amp;nbsp;A_c \space 2 \pi K_f \space \Bigg[ \int_{0}^{t} m(\tau) \space d \tau \Bigg] \space&amp;nbsp; sin (2 \pi f_c \space t) \Bigg \}&amp;nbsp;&amp;nbsp;$$" vertex="1">
