        <mxCell id="vJVjp1ZornpiyR5UvBJD-2" parent="1" style="shape=image;aspect=fixed;image=data:image/png,;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="239.58" width="282.93" x="531.6700000000001" y="2135.46" as="geometry" />
        </mxCell>
        <mxCell id="vJVjp1ZornpiyR5UvBJD-3" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$&amp;nbsp; |\alpha_k |= \Big| \frac{1}{2} sinc \big( \frac{k}{2} \big) \Big|$$" vertex="1">
          <mxGeometry height="60" width="205.71" x="582.05" y="2064.9900000000002" as="geometry" />
        </mxCell>
        <mxCell id="vJVjp1ZornpiyR5UvBJD-4" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$&amp;nbsp; \alpha_k = \frac{1}{2} sinc \big( \frac{k}{2} \big) = \frac{1}{2} \frac{sin (k \frac{\pi}{2})}{k \frac{\pi}{2}}$$" vertex="1">
          <mxGeometry height="82.41" width="330.1" x="-11.600000000000005" y="2444.57" as="geometry" />
        </mxCell>
        <mxCell id="vJVjp1ZornpiyR5UvBJD-5" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$&amp;nbsp; k = +1 \space \Rightarrow \space \alpha_{+1} = \frac{1}{2} \frac{sin(\frac{\pi}{2})}{\frac{\pi}{2}} \space \Rightarrow \space&amp;nbsp; \alpha_{+1} = \frac{1}{\pi}&amp;nbsp; \space \Rightarrow \space&amp;nbsp; \theta_{+1} = 0^o $$" vertex="1">
          <mxGeometry height="80" width="550" x="-120.74" y="2561.2200000000003" as="geometry" />
        </mxCell>
        <mxCell id="vJVjp1ZornpiyR5UvBJD-6" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$&amp;nbsp; k = -1 \space \Rightarrow \space \alpha_{-1} = \frac{1}{2} \frac{sin(\frac{-\pi}{2})}{\frac{-\pi}{2}} = \frac{-1}{-\pi}&amp;nbsp;&amp;nbsp;\space \Rightarrow \space&amp;nbsp; \alpha_{-1} = \frac{1}{\pi}&amp;nbsp; \space \Rightarrow \space&amp;nbsp; \theta_{-1} = 0^o $$" vertex="1">
          <mxGeometry height="80" width="640" x="-123.46" y="2652.97" as="geometry" />
        </mxCell>
        <mxCell id="vJVjp1ZornpiyR5UvBJD-7" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$&amp;nbsp; k = \pm 2 \space \Rightarrow \space \alpha_{\pm 2} = \frac{1}{2} \frac{sin(\pm \pi)}{\pm \pi} \space \Rightarrow \space&amp;nbsp; \alpha_{\pm 2} = 0&amp;nbsp; \space \Rightarrow \space&amp;nbsp; \nexists \space \theta_{\pm 2}&amp;nbsp;&amp;nbsp;$$" vertex="1">
          <mxGeometry height="80" width="520" x="-122.74" y="2769.43" as="geometry" />
        </mxCell>
        <mxCell id="vJVjp1ZornpiyR5UvBJD-8" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$&amp;nbsp; k = +3 \space \Rightarrow \space \alpha_{+3} = \frac{1}{2} \frac{sin(\frac{3 \pi}{2})}{\frac{3 \pi}{2}} \space \Rightarrow \space&amp;nbsp; \alpha_{+3} = \frac{-1}{3 \pi}&amp;nbsp; \space \Rightarrow \space&amp;nbsp; \theta_{+3} = \pm 180^o $$" vertex="1">
          <mxGeometry height="80" width="610.74" x="-120.74" y="2929.06" as="geometry" />
        </mxCell>
        <mxCell id="vJVjp1ZornpiyR5UvBJD-9" parent="1" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="120" width="20" x="-172.74" y="2585.94" as="geometry" />
        </mxCell>
        <mxCell id="vJVjp1ZornpiyR5UvBJD-10" parent="1" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="148.63" width="20" x="-172.74" y="2945.94" as="geometry" />
        </mxCell>
        <mxCell id="vJVjp1ZornpiyR5UvBJD-11" parent="1" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="60" width="20" x="-172.74" y="2781.81" as="geometry" />
        </mxCell>
        <mxCell id="vJVjp1ZornpiyR5UvBJD-12" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$&amp;nbsp; k = -3 \space \Rightarrow \space \alpha_{-3} = \frac{1}{2} \frac{sin(\frac{-3 \pi}{2})}{\frac{-3 \pi}{2}} \space \Rightarrow \space&amp;nbsp; \alpha_{-3} = \frac{1}{-3 \pi}&amp;nbsp; \space \Rightarrow \space&amp;nbsp; \theta_{-3} = \mp 180^o $$" vertex="1">
          <mxGeometry height="80" width="644.5" x="-124.5" y="3023.26" as="geometry" />
        </mxCell>
        <mxCell id="vJVjp1ZornpiyR5UvBJD-16" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$ \text{Also for:&amp;nbsp; } \space \theta_{\pm 5}, \space&amp;nbsp; \theta_{\pm 9}, \space \theta_{\pm 13}, \space&amp;nbsp; \theta_{\pm 17} \space ...&amp;nbsp;$$" vertex="1">
