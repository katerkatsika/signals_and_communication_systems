        <mxCell id="6iF8euNTpzHEX3f3-F1L-1" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$ \alpha_k = \frac {1}{To} \int_{To} x(t) \space e^{-jk 2 \pi f_ο t} dt $$" vertex="1">
          <mxGeometry height="64" width="306.42" x="252.85999999999999" y="392" as="geometry" />
        </mxCell>
        <mxCell id="mHAaG7M2AsDxtlTTQbIn-1" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFFFFF);" value="$$ \alpha_ο = \frac {1}{To} \int_{To} x(t) dt $$" vertex="1">
          <mxGeometry height="70" width="200" x="570" y="478.99999999999994" as="geometry" />
        </mxCell>
        <mxCell id="mHAaG7M2AsDxtlTTQbIn-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="3/ Υπολογισμός του συντελεστή της σειράςFourier για k = 0 (μέση τιμή μέσα σε μία περίοδο)" vertex="1">
          <mxGeometry height="30" width="766.18" x="-236.18" y="499" as="geometry" />
        </mxCell>
        <mxCell id="_B79zUG2fW1oDVfd8RLn-1" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFFFFF);" value="$$\alpha_ο = \frac {1}{4} \int_{-2}^{2} 0 \cdot dt&amp;nbsp; \Rightarrow \\ \\&amp;nbsp;\alpha_ο = \frac {1}{4} \int_{-2}^{1} 0 \cdot dt \space +&amp;nbsp; \space&amp;nbsp; \frac {1}{4} \int_{-1}^{1} 1 \cdot dt&amp;nbsp; \space +&amp;nbsp; \space&amp;nbsp;\frac {1}{4} \int_{1}^{2} 0 \cdot dt&amp;nbsp; \Rightarrow \\ \\ \alpha_ο =&amp;nbsp; \space&amp;nbsp; \frac {1}{4} \int_{-1}^{1} 1 \cdot dt&amp;nbsp; \space \Rightarrow&amp;nbsp; \alpha_ο = \frac {1}{4}&amp;nbsp;\big[ t \big]_{-1}^{1}&amp;nbsp; = \frac {1}{4} \cdot \big[ 1 - (-1)\big]&amp;nbsp; \Rightarrow \\ \\ \alpha_ο = \frac {1}{4} \cdot 2&amp;nbsp;&amp;nbsp;\Rightarrow&amp;nbsp; \space \alpha_ο = \frac {1}{2} $$" vertex="1">
          <mxGeometry height="340" width="556.08" x="-142.11" y="565" as="geometry" />
        </mxCell>
        <mxCell id="_B79zUG2fW1oDVfd8RLn-2" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#000000,#FFFF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="70" width="93.04" x="162.70000000000005" y="835" as="geometry" />
        </mxCell>
        <mxCell id="_B79zUG2fW1oDVfd8RLn-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="= Μέση τιμή του x(t)" vertex="1">
          <mxGeometry height="30" width="180" x="286.96" y="855" as="geometry" />
        </mxCell>
        <mxCell id="_B79zUG2fW1oDVfd8RLn-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="4/ Υπολογισμός των συντελεστών της σειράς Fourier για k &amp;gt; 0" vertex="1">
          <mxGeometry height="30" width="515.73" x="-235.73" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="_B79zUG2fW1oDVfd8RLn-6" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$ \alpha_k = \frac {1}{4} \int_{-2}^{-2} x(t) \space e^{-jk 2 \pi \frac{1}{4} t} dt&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; \alpha_k = \frac {1}{4} \int_{-2}^{-1} 0 \space e^{-jk \frac{\pi}{2}&amp;nbsp; t} +&amp;nbsp; \frac {1}{4} \int_{-1}^{1} 1 \space e^{-jk \frac{\pi}{2}&amp;nbsp; t}&amp;nbsp;+ \frac {1}{4} \int_{1}^{2} 0 \space e^{-jk \frac{\pi}{2}&amp;nbsp; t} dt&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; \alpha_k = \frac {1}{4}&amp;nbsp;&amp;nbsp;\int_{-1}^{1}&amp;nbsp; e^{-jk \frac{\pi}{2}&amp;nbsp; t} dt = -&amp;nbsp; \frac {1}{4} \cdot \frac{1}{jk \frac{\pi}{2}&amp;nbsp;}&amp;nbsp; \big[ e^{-jk \frac{\pi}{2}&amp;nbsp; t} \big]_{-1}^{1} = - \frac{1}{2 jk \pi}&amp;nbsp; \big( e^{-jk \frac{\pi}{2}} - e^{jk \frac{\pi}{2}} \big)&amp;nbsp; &amp;nbsp;\space \Rightarrow \\ \\&amp;nbsp; \alpha_k = \frac{1}{k \pi} \cdot \frac{\big( e^{jk \frac{\pi}{2}} - e^{-jk \frac{\pi}{2}} \big)}{2 j}&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; \alpha_k = \frac{1}{k \pi} sin \big(k \frac{\pi}{2} \big) = \frac{1}{2} \frac{1}{k \frac{\pi}{2}} sin \big( k \frac{\pi}{2} \big) = \frac{1}{2} \frac{sin(k \frac{\pi}{2})}{k \frac{\pi}{2}} \space \Rightarrow \\ \\&amp;nbsp; \alpha_k = \frac{1}{2} sinc \big( \frac{k}{2} \big)$$" vertex="1">
          <mxGeometry height="520" width="731.49" x="-215.75" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="_B79zUG2fW1oDVfd8RLn-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$ x(t) $$" vertex="1">
          <mxGeometry height="30" width="38.46" x="151.54" y="-129.84" as="geometry" />
