        <mxCell id="3vpEfWhDhuS53K7oF_ry-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#FFFFFF,#FFF2CC);" value="2/ Ευθύς ή Ανάστροφος Fourier Transform;&amp;nbsp; &amp;nbsp;--&amp;gt; Ευθύς" vertex="1">
          <mxGeometry height="30" width="457.08" x="-316.46" y="614" as="geometry" />
        </mxCell>
        <mxCell id="3vpEfWhDhuS53K7oF_ry-3" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$ \alpha_k = \frac {1}{To} \int_{T_o} x(t) \space e^{-jk 2 \pi f_ο t} dt $$" vertex="1">
          <mxGeometry height="64" width="306.42" x="173.58000000000004" y="597" as="geometry" />
        </mxCell>
        <mxCell id="3vpEfWhDhuS53K7oF_ry-4" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFFFFF);" value="$$ \alpha_ο = \frac {1}{To} \int_{To} x(t) dt $$" vertex="1">
          <mxGeometry height="70" width="200" x="490.72" y="684" as="geometry" />
        </mxCell>
        <mxCell id="3vpEfWhDhuS53K7oF_ry-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#FFFFFF,#FFF2CC);" value="3/ Υπολογισμός του συντελεστή της σειράςFourier για k = 0 (μέση τιμή μέσα σε μία περίοδο)" vertex="1">
          <mxGeometry height="30" width="766.18" x="-315.46" y="704" as="geometry" />
        </mxCell>
        <mxCell id="3vpEfWhDhuS53K7oF_ry-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$ T = 8 \space \text{sec}&amp;nbsp; \space \rightarrow \space f = \frac{1}{ 8} \space \text{Hz} $$" vertex="1">
          <mxGeometry height="60" width="270.73" x="29.269999999999982" y="510" as="geometry" />
        </mxCell>
        <mxCell id="VWNTQ0cX4noz70ZJDpFH-1" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFFFFF);" value="$$ \alpha_ο = \frac {1}{8} \int_{-1}^{3} 1 dt&amp;nbsp; \space \Rightarrow&amp;nbsp; \alpha_ο = \frac {1}{8} \big[ 3 - (-1) \big]&amp;nbsp;&amp;nbsp;&amp;nbsp;\space \Rightarrow&amp;nbsp; \alpha_ο = \frac {1}{8} \cdot 4 \space \Rightarrow&amp;nbsp; \alpha_ο =&amp;nbsp;&amp;nbsp;&amp;nbsp;\frac {1}{2}&amp;nbsp;$$" vertex="1">
          <mxGeometry height="80" width="640" x="-280" y="780" as="geometry" />
        </mxCell>
        <mxCell id="bslCoFFtOcyzCU6oRUX7-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#FFFFFF,#FFF2CC);" value="4/ Υπολογισμός των συντελεστών της σειράς Fourier για k &amp;gt; 0" vertex="1">
          <mxGeometry height="30" width="515.73" x="-320" y="930" as="geometry" />
        </mxCell>
        <mxCell id="bslCoFFtOcyzCU6oRUX7-2" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$ \alpha_k = \frac {1}{8} \int_{-1}^{3} 1 \space e^{-jk 2 \pi \frac{1}{8} t} dt&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; \alpha_k = \frac {1}{8} \int_{-1}^{3} 1 \space e^{-jk \frac{\pi}{4} t} dt&amp;nbsp; = - \frac {1}{8 j k \frac{\pi}{4}} \big[ e^{-jk \frac{\pi}{4} t}&amp;nbsp; \big]_{-1}^{3}&amp;nbsp; &amp;nbsp;\space \Rightarrow \\ \\&amp;nbsp; \alpha_k = \frac{j}{2 k \pi} \big[ e^{-jk \frac{3 \pi}{4}}&amp;nbsp; - e^{jk \frac{\pi}{4}}&amp;nbsp;&amp;nbsp;\big]&amp;nbsp;&amp;nbsp;&amp;nbsp;\space \Rightarrow \\ \\&amp;nbsp; \alpha_k =&amp;nbsp; \frac{j}{2 k \pi}&amp;nbsp; \Big[ cos \left( k \frac{3 \pi}{4} \right)&amp;nbsp; - j sin \left( k \frac{3 \pi}{4} \right)&amp;nbsp; - cos \left( k \frac{\pi}{4} \right) - j sin \left( k \frac{\pi}{4} \right)&amp;nbsp;&amp;nbsp;\Big]&amp;nbsp;&amp;nbsp;&amp;nbsp;\space \Rightarrow \\ \\&amp;nbsp; \alpha_k = \frac{j}{2 k \pi}&amp;nbsp;&amp;nbsp;&amp;nbsp;\Big[ cos \left( k \frac{3 \pi}{4} \right) -&amp;nbsp; cos \left( k \frac{\pi}{4} \right)&amp;nbsp;\Big]&amp;nbsp; - j&amp;nbsp; \frac{j}{2 k \pi}&amp;nbsp; \Big[ sin \left( k \frac{3 \pi}{4} \right) + sin \left( k \frac{\pi}{4} \right) \Big]&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; \alpha_k = \frac{1}{2 k \pi}&amp;nbsp; \Big[ sin \left( k \frac{3 \pi}{4} \right) + sin \left( k \frac{\pi}{4} \right) \Big]&amp;nbsp; + j&amp;nbsp;&amp;nbsp;&amp;nbsp;\frac{1}{2 k \pi} \Big[ cos \left( k \frac{3 \pi}{4} \right) -&amp;nbsp; cos \left( k \frac{\pi}{4} \right) \Big]$$" vertex="1">
          <mxGeometry height="500" width="772.13" x="-332.13" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="MTujaH-EhTieQmGQ5jOm-1" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#000000,#FFFF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="55" width="98.5" x="274" y="793" as="geometry" />
