          <mxGeometry height="80" width="205.24" x="-281.8" y="1662.79" as="geometry" />
        </mxCell>
        <mxCell id="ngrVv-W6jsqVwP9lhKM2-3" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFF2CC);" value="$$ \alpha_{k} = \alpha^{*}_{-k}&amp;nbsp;&amp;nbsp;$$" vertex="1">
          <mxGeometry height="40" width="130.59" x="-226.99999999999997" y="2419" as="geometry" />
        </mxCell>
        <mxCell id="ngrVv-W6jsqVwP9lhKM2-4" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFFFFF);" value="$$ |\alpha_{\pm1}| = \sqrt{ \Bigg[\frac {\sqrt{2}}{2 \pi} \bigg]^2&amp;nbsp; + \Bigg[\frac {\sqrt{2}}{2 \pi} \bigg]^2&amp;nbsp;&amp;nbsp;}&amp;nbsp; = \sqrt{\frac{2 \cdot 2}{4 \pi^2}} = \sqrt{\frac{1}{\pi^2}} \space \Rightarrow \space&amp;nbsp; |\alpha_{\pm1}| =&amp;nbsp; \frac{1}{\pi} $$" vertex="1">
