        <mxCell id="H0I_Q1-ur6H8T4g0ZwCl-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="1/ Είναι Περιοδικό Σήμα;&amp;nbsp; &amp;nbsp;--&amp;gt; ΝΑΙ" vertex="1">
          <mxGeometry height="30" width="310.19" x="80.00000000000003" y="965" as="geometry" />
        </mxCell>
        <mxCell id="H0I_Q1-ur6H8T4g0ZwCl-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="2/ Ευθύς ή Ανάστροφος Fourier Transform;&amp;nbsp; &amp;nbsp;--&amp;gt; Ευθύς" vertex="1">
          <mxGeometry height="30" width="457.08" x="83.54000000000002" y="1054" as="geometry" />
        </mxCell>
        <mxCell id="H0I_Q1-ur6H8T4g0ZwCl-3" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$ \alpha_k = \frac {1}{To} \int_{T_o} x(t) \space e^{-jk 2 \pi f_ο t} dt $$" vertex="1">
          <mxGeometry height="64" width="306.42" x="573.58" y="1037" as="geometry" />
        </mxCell>
        <mxCell id="H0I_Q1-ur6H8T4g0ZwCl-4" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFFFFF);" value="$$ \alpha_ο = \frac {1}{To} \int_{To} x(t) dt $$" vertex="1">
          <mxGeometry height="70" width="200" x="890.72" y="1124" as="geometry" />
        </mxCell>
        <mxCell id="H0I_Q1-ur6H8T4g0ZwCl-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="3/ Υπολογισμός του συντελεστή της σειράςFourier για k = 0 (μέση τιμή μέσα σε μία περίοδο)" vertex="1">
          <mxGeometry height="30" width="766.18" x="84.54000000000002" y="1144" as="geometry" />
        </mxCell>
        <mxCell id="H0I_Q1-ur6H8T4g0ZwCl-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$ T = 2 \pi \space \text{sec}&amp;nbsp; \space \rightarrow \space f = \frac{1}{ 2 \pi} \space \text{Hz} $$" vertex="1">
          <mxGeometry height="60" width="270.73" x="429.27" y="950" as="geometry" />
        </mxCell>
        <mxCell id="7O10P6KFN1aIzHurNrUB-1" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFFFFF);" value="$$ \alpha_ο = \frac {1}{2 \pi} \int_{-\pi}^{+\pi} t \space dt \space \Rightarrow \\ \\ \alpha_ο = \frac {1}{2 \pi} \frac{1}{2} \big[ t^2 \big]_{- \pi}^{\pi}&amp;nbsp; = \frac {1}{4 \pi} \big[ \pi^2 - (-\pi)^2 \big] = \frac {1}{4 \pi}&amp;nbsp;\cdot 0&amp;nbsp; &amp;nbsp;\space \Rightarrow \\ \\ \alpha_ο =&amp;nbsp; 0 $$" vertex="1">
          <mxGeometry height="230" width="529" x="246.5" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="7O10P6KFN1aIzHurNrUB-2" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFFFFF);" value="$$x(t) = t $$" vertex="1">
          <mxGeometry height="50" width="120" x="483.83" y="426.15999999999997" as="geometry" />
        </mxCell>
        <mxCell id="1-6txffAlTpBMITxN04v-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="4/ Υπολογισμός των συντελεστών της σειράς Fourier για k &amp;gt; 0" vertex="1">
          <mxGeometry height="30" width="515.73" x="84.54000000000003" y="1490" as="geometry" />
        </mxCell>
        <mxCell id="1-6txffAlTpBMITxN04v-2" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;labelBackgroundColor=none;" value="$$ \alpha_k = \frac {1}{2 \pi} \int_{- \pi}^{+\pi} t\space e^{-jk 2 \pi \frac{1}{2 \pi} t} dt \space \Rightarrow \\ \\&amp;nbsp; &amp;nbsp;\alpha_k = \frac {1}{2 \pi} \big( - \frac{1}{j k} \big) \big[ t \space e^{-jk t} \big|_{-\pi}^{+\pi}&amp;nbsp; - \int_{- \pi}^{+\pi} (t)&#39; \space e^{-jk t} \space dt&amp;nbsp;&amp;nbsp;\big]&amp;nbsp; &amp;nbsp;\space \Rightarrow \\ \\&amp;nbsp; &amp;nbsp;\alpha_k = \frac {j}{2 k \pi} \big[ \pi e^{-jk \pi} + \pi e^{jk \pi}&amp;nbsp; \big]&amp;nbsp; - \frac {j}{2 k \pi}&amp;nbsp; \int_{- \pi}^{+\pi}&amp;nbsp; e^{-jk t} \space dt&amp;nbsp; &amp;nbsp;\space \Rightarrow \\ \\&amp;nbsp; &amp;nbsp;\alpha_k =&amp;nbsp; j \frac{1}{k} cos (k \pi) + \frac {j}{2 k \pi j k} \big[ e^{-j k t} \big]_{-\pi}^{+\pi} \space \Rightarrow \\ \\&amp;nbsp; &amp;nbsp;\alpha_k = j \frac{1}{k} cos (k \pi) + \frac{1}{2 k^2} \big[ e^{-j k \pi}&amp;nbsp;- e^{j k \pi}&amp;nbsp;\big]&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; &amp;nbsp;\alpha_k = j \frac{1}{k} cos (k \pi) - \frac{j}{k^2} sin (k \pi)&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; &amp;nbsp;\alpha_k = j \frac{1}{k} cos (k \pi)&amp;nbsp; = j \space \frac{1}{k} (-1)^k&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; &amp;nbsp;\alpha_k = j \frac{(-1)^k}{k}$$" vertex="1">
          <mxGeometry height="650" width="530" x="246.5" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="IutGDTDl0cWqeA5BjH4i-1" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#000000,#FFFF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="80" width="170.73" x="429.27" y="2144" as="geometry" />
        </mxCell>
