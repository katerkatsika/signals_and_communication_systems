        <mxCell id="mgfRmMKM0BqbAOkB6z37-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=19;" value="$$ F \big[ x(t) \space cos (2 \pi f_o \space t)&amp;nbsp; \big] = \frac{1}{2} \Bigg\{ F \big[ e^{j 2 \pi f_o \space t} \cdot x(t) \big] + F \big[&amp;nbsp;e^{-j 2 \pi f_o \space t} \cdot x(t) \big]&amp;nbsp; &amp;nbsp;\Bigg\}&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; F \big[ x(t) \space cos (2 \pi f_o \space t)&amp;nbsp; \big] = \frac{1}{2} \big[ X(f - f_o) + X(f + f_o)&amp;nbsp;&amp;nbsp;\big]&amp;nbsp; $$" vertex="1">
