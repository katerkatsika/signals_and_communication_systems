        <mxCell id="HAqPlh7xLuEJZq5kx1lx-31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Να βρεθεί ο μετασχηματισμός Fourier του τετραγωνικού παλμού.&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="550" x="-270" y="-100" as="geometry" />
        </mxCell>
        <mxCell id="HAqPlh7xLuEJZq5kx1lx-32" edge="1" parent="1" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;fontColor=light-dark(#000000,#FFF2CC);strokeColor=light-dark(#000000,#FFF2CC);endArrow=none;endFill=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="">
          <mxGeometry relative="1" width="80" as="geometry">
            <Array as="points" />
            <mxPoint x="-270" y="-60" as="sourcePoint" />
            <mxPoint x="1010" y="-60" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r7SECt-Ym7NjXbZX82CG-1" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=21;labelBackgroundColor=default;" value="&lt;font&gt;$$ X(f) = \int_{-\infty}^{\infty} x(t) \space e^{-j2 \pi f t} \space dt&amp;nbsp; = \int_{-\tau/2}^{\tau/2} \frac{1}{2} \cdot e^{-j 2 \pi f \space t} \space dt = - \frac{1}{2} \frac{1}{j \space 2 \pi f} \Bigg [ e^{- j \space 2 \pi f \space t}&amp;nbsp; &amp;nbsp;\Bigg ]_{- \tau / 2}^{\tau / 2}&amp;nbsp; \space \Rightarrow&amp;nbsp; \\ \\ X(f) =&amp;nbsp;&amp;nbsp;&amp;nbsp;- \frac{1}{2} \frac{1}{j \space 2 \pi f} \Bigg [ e^{- j \space \pi f \space \tau} -&amp;nbsp; e^{ j \space \pi f \space \tau}&amp;nbsp; \Bigg ]&amp;nbsp; = \frac{1}{2} \frac{1}{\pi f}&amp;nbsp; \cdot \frac{e^{ j \space \pi f \space \tau} -&amp;nbsp; e^{ - j \space \pi f \space \tau}}{2 j}&amp;nbsp; \space \Rightarrow \\ \\ X(f) = \frac{\tau}{\tau} \cdot \frac{1}{2} \cdot \frac{1}{\pi f} \cdot&amp;nbsp; sin(\pi f \space \tau) = \frac{\tau}{2} \cdot \frac{sin(\pi f \space \tau) }{(\pi f \space \tau)} \space \Rightarrow \\ \\ X(f) =&amp;nbsp; &amp;nbsp;\frac{\tau}{2}&amp;nbsp;\cdot sinc(\pi f \space \tau) \space \Rightarrow \space X(f) = \frac{\tau}{2}&amp;nbsp;\cdot sinc( f \space \tau)&amp;nbsp;&amp;nbsp;$$&lt;/font&gt;" vertex="1">
          <mxGeometry height="390" width="873.74" x="75.82" y="390" as="geometry" />
        </mxCell>
        <mxCell id="HZrTuyymITxzQi5kxfVb-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontFamily=Lucida Console;" value="$$ x(t) =&amp;nbsp; $$" vertex="1">
