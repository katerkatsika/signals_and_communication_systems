        <mxCell id="HAqPlh7xLuEJZq5kx1lx-30" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=21;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontFamily=Lucida Console;" value="$$ t $$" vertex="1">
