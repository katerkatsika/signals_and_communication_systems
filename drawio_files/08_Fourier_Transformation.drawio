        </mxCell>
        <mxCell id="0MuD8L05ND1MabVz-G4Q-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=15;fontFamily=Lucida Console;" value="$$ z^2&amp;nbsp; = z \cdot z^* \space \Rightarrow |z| = \sqrt{z \cdot z^*}$$" vertex="1">
