        <mxCell id="0MuD8L05ND1MabVz-G4Q-5" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=15;labelBackgroundColor=none;fontFamily=Lucida Console;" value="&lt;font&gt;$$ \Bigg | X(f) \Bigg |&amp;nbsp; =&amp;nbsp; \frac{1}{&amp;nbsp; \sqrt{\alpha^2 + (2 \pi f)^2 \space } }&amp;nbsp;&amp;nbsp;$$&lt;/font&gt;" vertex="1">
