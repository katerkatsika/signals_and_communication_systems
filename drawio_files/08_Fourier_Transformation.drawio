        <mxCell id="Tl5LzfYj7WrtNDvZtgRi-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$ x(t) = \frac{1}{\tau} \big[ \Pi_{\tau/2} (t&amp;nbsp; - \tau /2) - \Pi_{-\tau/2} (t&amp;nbsp; + \tau /2)&amp;nbsp;&amp;nbsp;\big] $$" vertex="1">
          <mxGeometry height="60" width="420" x="-130" y="620" as="geometry" />
        </mxCell>
        <mxCell id="Tl5LzfYj7WrtNDvZtgRi-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$ X(f) = \frac{1}{\tau} \big[ \tau \space sinc (\pi f t) \cdot e^{-j 2 \pi f \space \frac{\tau}{2}}&amp;nbsp; - \tau \space sinc (\pi f t) \cdot e^{j 2 \pi f \space \frac{\tau}{2}}&amp;nbsp;&amp;nbsp;\big] $$" vertex="1">
          <mxGeometry height="80" width="580" x="-185" y="700" as="geometry" />
        </mxCell>
        <mxCell id="Tl5LzfYj7WrtNDvZtgRi-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$ X(f) = - 2 j&amp;nbsp; \space sinc (\pi f t) \cdot \big[ \frac{e^{j 2 \pi f \space \frac{\tau}{2}}&amp;nbsp; - \space e^{-j 2 \pi f \space \frac{\tau}{2}}}{2 j}&amp;nbsp; \big]$$" vertex="1">
          <mxGeometry height="80" width="455" x="-122.5" y="800.76" as="geometry" />
        </mxCell>
        <mxCell id="Tl5LzfYj7WrtNDvZtgRi-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$ X(f) = - 2 j&amp;nbsp; \space sinc (\pi f t) \cdot sin(\pi f t) \space \Rightarrow \\ \\&amp;nbsp; X(f) = - 2 j \space \frac{sin^2{(\pi f t)}}{\pi f t}$$" vertex="1">
