        <mxCell id="g_WXULCovfyKkrihT6A0-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=17;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFF2CC);" value="$$ x(t) = e^{-\alpha t} \cdot u(t) $$" vertex="1">
          <mxGeometry height="47.72" width="170" x="-150" y="-63" as="geometry" />
        </mxCell>
        <mxCell id="f4LucAWyrq7S0vnKEtS3-1" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=15;labelBackgroundColor=none;fontFamily=Lucida Console;" value="&lt;font&gt;$$ X(f) = \int_{-\infty}^{+\infty} x(t) \space e^{-j \space 2 \pi f \space t} \space dt&amp;nbsp; =&amp;nbsp; \int_{-\infty}^{\infty} e^{- \alpha t} \cdot u(t) \space e^{-j \space 2 \pi f \space t} \space dt&amp;nbsp; \Rightarrow \\ \\&amp;nbsp; X(f) =&amp;nbsp;&amp;nbsp;\int_{0}^{+\infty} e^{- \alpha t} \space e^{-j \space 2 \pi f \space t}&amp;nbsp; \space dt&amp;nbsp; = \int_{0}^{+\infty} e^{- (\alpha + j \space 2 \pi f) \space t}&amp;nbsp; \space dt&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; X(f) = - \frac{1}{\alpha + j \space 2 \pi f} \Bigg[ e^{-(\alpha + j \space 2 \pi f) \space t}&amp;nbsp; \Bigg]_{0}^{+\infty}&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; X(f) =&amp;nbsp; - \frac{1}{\alpha + j \space 2 \pi f} \space (0 - 1) \space \Rightarrow \\ \\&amp;nbsp; X(f) =&amp;nbsp; \frac{1}{\alpha + j \space 2 \pi f}&amp;nbsp;&amp;nbsp;$$&lt;/font&gt;" vertex="1">
