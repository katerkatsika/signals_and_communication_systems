  <diagram id="ivqoC8oVG7ZsC67kWPys" name="Square Inverse FT">
    <mxGraphModel dx="2136" dy="1359" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="3GvajH5tiiAyLDgLmhrq-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Να βρεθεί από ποιο σήμα έχει προέλθει το ακόλουθο φάσμα&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="520" x="-360" y="-121" as="geometry" />
        </mxCell>
        <mxCell id="3GvajH5tiiAyLDgLmhrq-12" edge="1" parent="1" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;fontColor=light-dark(#000000,#FFF2CC);strokeColor=light-dark(#000000,#FFF2CC);endArrow=none;endFill=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="">
          <mxGeometry relative="1" width="80" as="geometry">
            <Array as="points" />
            <mxPoint x="-360" y="-81" as="sourcePoint" />
            <mxPoint x="920" y="-81" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="HDS8C_vSjqZg0lX_BhNJ-1" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=21;labelBackgroundColor=default;" value="&lt;font&gt;$$ x(t) = \int_{-\infty}^{\infty} X(f) \space e^{j \space 2 \pi f \space t} \space df&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp;\int_{-w/2}^{+w/2} \frac{1}{2} \space e^{j \space 2 \pi f \space t} \space df =&amp;nbsp; \frac{1}{2}&amp;nbsp;\int_{-w/2}^{+w/2} \space e^{j \space 2 \pi f \space t} \space df \space \Rightarrow \\ \\&amp;nbsp; x(t) =&amp;nbsp; \frac{1}{2} \space \frac{1}{j \space 2 \pi \space t}&amp;nbsp; \Bigg[ e^{j \space 2 \pi f \space t} \Bigg]_{-w/2}^{w/2}&amp;nbsp; = \frac{1}{2} \space \frac{1}{2 j \space \pi \space t} \big[ e^{j \space \pi w \space t} -&amp;nbsp; e^{-j \space \pi w \space t}&amp;nbsp; \big]&amp;nbsp; \space \Rightarrow \\ \\ x(t) =&amp;nbsp; \frac{1}{2 \pi \space t} \space \frac{e^{j \space \pi w \space t} -&amp;nbsp; e^{-j \space \pi w \space t}}{2j}&amp;nbsp; =&amp;nbsp;&amp;nbsp;\frac{1}{2 \pi \space t} \space sin (\pi w \space t) = \frac{w}{w} \space \frac{1}{2 \pi \space t} \space sin (\pi w \space t) \space \Rightarrow \\ \\ x(t) =&amp;nbsp; \frac{w}{2} \space \frac{sin (\pi w \space t)}{\pi w \space t} \space \Rightarrow \\ \\ x(t) = \frac{w}{2} \space sinc(\pi w \space t)$$&lt;/font&gt;" vertex="1">
          <mxGeometry height="490" width="851.94" x="-38.50999999999999" y="350" as="geometry" />
        </mxCell>
