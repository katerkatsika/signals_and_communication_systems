  <diagram id="ywjVogcwBmKfK9h2KleV" name="Linearity">
    <mxGraphModel dx="2136" dy="959" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="kOsCdinkC9UGyz-q3fMH-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Να βρεθεί ο Μετασχηματισμός Fourier&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 242, 204));&quot;&gt;&amp;nbsp;του σήματος&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="440" x="-201.82" y="210" as="geometry" />
        </mxCell>
        <mxCell id="kOsCdinkC9UGyz-q3fMH-5" edge="1" parent="1" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;fontColor=light-dark(#000000,#FFF2CC);strokeColor=light-dark(#000000,#FFF2CC);endArrow=none;endFill=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="">
          <mxGeometry relative="1" width="80" as="geometry">
            <Array as="points" />
            <mxPoint x="-201.82" y="332" as="sourcePoint" />
            <mxPoint x="1078.18" y="332" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="kOsCdinkC9UGyz-q3fMH-7" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=21;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFF2CC);" value="&lt;font&gt;$$ x(t) = cos (2 \pi f_o t) $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="211" x="-58.74999999999999" y="262" as="geometry" />
        </mxCell>
        <mxCell id="kOsCdinkC9UGyz-q3fMH-8" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=21;labelBackgroundColor=none;" value="&lt;font&gt;$$ X(f) = F \big[ cos (2 \pi f_o t) \big]&amp;nbsp; = F \Bigg \{ \frac{e^{j \space 2 \pi f_o \space t} + e^{- j \space 2 \pi f_o \space t}}{2} \Bigg \} \space \Rightarrow \\ \\ X(f) = \frac{1}{2} \space F \Bigg \{ e^{j \space 2 \pi f_o \space t}&amp;nbsp; \Bigg \} +&amp;nbsp; \frac{1}{2} \space F \Bigg \{ e^{- j \space 2 \pi f_o \space t}&amp;nbsp; \Bigg \}&amp;nbsp; space \Rightarrow \\ \\ X(f) =&amp;nbsp; \frac{1}{2} \space \big [ \delta (f + f_o) + \delta (f - f_o)&amp;nbsp;&amp;nbsp;\big ]&amp;nbsp;$$&lt;/font&gt;" vertex="1">
          <mxGeometry height="289" width="591.93" x="13.13" y="847" as="geometry" />
        </mxCell>
        <mxCell id="Lwqp3NYR_l6sOlS4joMi-1" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=21;labelBackgroundColor=none;" value="&lt;font&gt;$$ X(f) = F \big[ cos (2 \pi f_o t) \big] $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="270" x="-87.34" y="412" as="geometry" />
        </mxCell>
        <mxCell id="Lwqp3NYR_l6sOlS4joMi-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Πρέπει να βρούμε:" vertex="1">
          <mxGeometry height="30" width="160.01" x="-160" y="372" as="geometry" />
        </mxCell>
        <mxCell id="Lwqp3NYR_l6sOlS4joMi-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Μπορούμε να το υπολογίσουμε από την εξίσωση ορισμού του Μετασχηματισμού Fourier" vertex="1">
          <mxGeometry height="30" width="750.11" x="-160" y="492" as="geometry" />
        </mxCell>
        <mxCell id="KbrLB6Ak9Wg8U2TanrRv-1" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=21;labelBackgroundColor=none;" value="&lt;font&gt;$$ X(f) = \int_{-\infty}^{\infty} x(t) \space e^{-j \space 2 \pi f \space t} \space dt&amp;nbsp; =&amp;nbsp;&amp;nbsp;\int_{-\infty}^{\infty} cos (2 \pi f_o\space t) \cdot e^{-j \space 2 \pi f_o \space t} \space dt&amp;nbsp;&amp;nbsp;&amp;nbsp;$$&lt;/font&gt;" vertex="1">
          <mxGeometry height="106.26" width="669.44" x="-90.25" y="537.57" as="geometry" />
        </mxCell>
        <mxCell id="KbrLB6Ak9Wg8U2TanrRv-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Αυτός ο τρόπος όμως έχει πολλές πράξεις..." vertex="1">
          <mxGeometry height="30" width="379.59" x="-160" y="660" as="geometry" />
        </mxCell>
        <mxCell id="KbrLB6Ak9Wg8U2TanrRv-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=19;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Ένας δεύτερος και πιο απλός/σύντομος τρόπος είναι να αναλύσουμε το συνιμητονοείδες σήμα σύμφωνα με την εξίσωση του Euler και μετά να κάνουμε χρήση της ιδιότητας της Γραμμικότητας του Μετασχηματισμού Fourier (βλ. αντίστοιχο Πίνακα)." vertex="1">
