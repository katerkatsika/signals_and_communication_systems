        <mxCell id="sNDCRV15w-kOry06V9eA-162" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=27;labelBackgroundColor=none;fontFamily=Lucida Console;" value="&lt;font&gt;$$F^{-1} \big[X(f) \big] = x(t) = \int_{-\infty}^{\infty} X(f) \space e^{j \space 2 \pi f \space t} \space df $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="87.5" width="520" x="800" y="-558.75" as="geometry" />
        </mxCell>
