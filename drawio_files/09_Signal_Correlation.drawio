  <diagram id="ExSRl913qojNG499QoUv" name="Exercise 2">
    <mxGraphModel dx="618" dy="939" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="1" shadow="0">
