        <mxCell id="5dCMrEtK3-4YW5_1JPM_-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;" value="$$ A = 2 \pi f_c \space t_1 + \Theta $$" vertex="1">
          <mxGeometry height="30.73" width="99" x="594.14" y="926" as="geometry" />
        </mxCell>
        <mxCell id="5dCMrEtK3-4YW5_1JPM_-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;" value="$$ B = 2 \pi f_c \space t_2 + \Theta $$" vertex="1">
          <mxGeometry height="30.73" width="98.09" x="594.3499999999999" y="956.2900000000001" as="geometry" />
        </mxCell>
        <mxCell id="5dCMrEtK3-4YW5_1JPM_-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;" value="$$ R_{X}(t_1, t_2)&amp;nbsp; =&amp;nbsp; \frac{A^2}{2} \space E \Bigg \{ cos \big[2 \pi f_c \space (t_1 - t_2) \big]&amp;nbsp; +&amp;nbsp; &amp;nbsp;cos \big[2 \pi f_c \space (t_1 + t_2)&amp;nbsp; + 2 \Theta \big]&amp;nbsp;&amp;nbsp;\Bigg \}&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; R_{X}(t_1, t_2)&amp;nbsp; =&amp;nbsp; \frac{A^2}{2} \space E&amp;nbsp;\Bigg \{ cos \big[2 \pi f_c \space (t_1 - t_2) \big]&amp;nbsp; \Bigg \} +&amp;nbsp;&amp;nbsp;&amp;nbsp;\frac{A^2}{2} \space E \Bigg \{ cos \big[2 \pi f_c \space (t_1 + t_2) + 2 \Theta \big]&amp;nbsp; \Bigg \}$$" vertex="1">
          <mxGeometry height="94.22" width="427.91" x="525.4799999999999" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="5dCMrEtK3-4YW5_1JPM_-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;" value="$$&amp;nbsp; E&amp;nbsp;\Bigg \{ cos \big[2 \pi f_c \space (t_1 - t_2) \big]&amp;nbsp; \Bigg \} = \int_{-\infty}^{+\infty} cos \big[2 \pi f_c \space (t_1 - t_2) \big] \space f_{\Theta}(\theta) \space d \theta&amp;nbsp; = $$" vertex="1">
          <mxGeometry height="50" width="358.83" x="551.5899999999999" y="1227.02" as="geometry" />
        </mxCell>
        <mxCell id="5dCMrEtK3-4YW5_1JPM_-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;" value="$$&amp;nbsp; =&amp;nbsp; \int_{-\infty}^{0} \Bigg\{ cos \big[2 \pi f_c \space (t_1 - t_2) \big] \cdot 0 \space \Bigg \} \space d \theta&amp;nbsp;+ \int_{0}^{2 \pi} cos \big[2 \pi f_c \space (t_1 - t_2) \big] \space \frac{1}{2 \pi} \space d \theta&amp;nbsp; &amp;nbsp;+&amp;nbsp;&amp;nbsp;&amp;nbsp;\int_{2 \pi}^{+\infty} \Bigg\{ cos \big[2 \pi f_c \space (t_1 - t_2) \big] \cdot 0 \space \Bigg \} \space d \theta&amp;nbsp;\space = $$" vertex="1">
          <mxGeometry height="50" width="600" x="685.38" y="1290.8600000000001" as="geometry" />
        </mxCell>
        <mxCell id="5dCMrEtK3-4YW5_1JPM_-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;" value="$$&amp;nbsp; =&amp;nbsp; &amp;nbsp;\int_{0}^{2 \pi} cos \big[2 \pi f_c \space (t_1 - t_2) \big] \space \frac{1}{2 \pi} \space d \theta&amp;nbsp; =&amp;nbsp; \frac{1}{2 \pi} \space&amp;nbsp; &amp;nbsp;cos \big[2 \pi f_c \space (t_1 - t_2) \big] \space \int_{0}^{2 \pi}&amp;nbsp;d \theta&amp;nbsp; =&amp;nbsp;&amp;nbsp;&amp;nbsp;\frac{1}{2 \pi} \space cos \big[2 \pi f_c \space (t_1 - t_2) \big] \space \big[ \theta \big]_{0}^{2 \pi}&amp;nbsp; &amp;nbsp;\space \Rightarrow&amp;nbsp; $$" vertex="1">
          <mxGeometry height="50" width="550.76" x="691.42" y="1360.8600000000001" as="geometry" />
        </mxCell>
        <mxCell id="5dCMrEtK3-4YW5_1JPM_-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;" value="$$ =&amp;nbsp; \frac{1}{2 \pi} \space cos \big[2 \pi f_c \space (t_1 - t_2) \big] \space \big[&amp;nbsp; 2 \pi - 0 \big]&amp;nbsp;= \frac{1}{2 \pi} \space cos \big[2 \pi f_c \space (t_1 - t_2) \big] \cdot (2 \pi)&amp;nbsp; \space \Rightarrow $$" vertex="1">
          <mxGeometry height="50" width="376.63" x="693.37" y="1429.86" as="geometry" />
        </mxCell>
