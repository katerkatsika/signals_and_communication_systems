        <mxCell id="4h8-pLKNuxjI_1zx1yst-3" parent="1" style="text;strokeColor=none;align=center;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;labelBackgroundColor=none;fontColor=light-dark(#000000,#FFFFFF);fontFamily=Lucida Console;" value="&lt;font&gt;Μη - Περιοδικά&lt;/font&gt; Σήματα:&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;div&gt;Μετασχηματισμός Fourier --&amp;gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
