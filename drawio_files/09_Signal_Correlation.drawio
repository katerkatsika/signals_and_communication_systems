          </mxGeometry>
        </mxCell>
        <mxCell id="Ejouf2bbWhGXYELRaLHK-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFF2CC);" value="$$ X(t) = A \space cos (2 \pi f_c \space t&amp;nbsp; + \Theta) $$" vertex="1">
          <mxGeometry height="30" width="150" x="620" y="-330" as="geometry" />
        </mxCell>
        <mxCell id="Ejouf2bbWhGXYELRaLHK-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="όπου Α και f&lt;sub&gt;c&lt;/sub&gt; σταθερές. Η παράμετρος Θ είναι μία τυχαία μεταβλητή με συνάρτηση πυκνότητας πιθανότητας:" vertex="1">
          <mxGeometry height="30" width="380" x="520" y="-280" as="geometry" />
        </mxCell>
        <mxCell id="Ejouf2bbWhGXYELRaLHK-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFF2CC);" value="$$ f_{\Theta}(\theta) =&amp;nbsp; $$" vertex="1">
          <mxGeometry height="30" width="50" x="620" y="-200" as="geometry" />
        </mxCell>
        <mxCell id="Ejouf2bbWhGXYELRaLHK-4" parent="1" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;strokeColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="66" width="20" x="676" y="-215" as="geometry" />
        </mxCell>
        <mxCell id="Ejouf2bbWhGXYELRaLHK-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFF2CC);" value="$$ \frac{1}{2 \pi} \space \text{&amp;nbsp; for:&amp;nbsp; } \space 0 \leq \theta \leq 2 \pi&amp;nbsp; $$" vertex="1">
          <mxGeometry height="30" width="130" x="696" y="-215" as="geometry" />
        </mxCell>
        <mxCell id="Ejouf2bbWhGXYELRaLHK-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFF2CC);" value="$$ 0 \space \text{&amp;nbsp; elsewhere&amp;nbsp; }&amp;nbsp; $$" vertex="1">
          <mxGeometry height="30" width="80" x="706" y="-179" as="geometry" />
        </mxCell>
        <mxCell id="Ejouf2bbWhGXYELRaLHK-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="δηλαδή η τυχαία μεταβλητή ακολουθεί ομοιόμορφη κατανομή στο [0, 2π]&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Να υπολογιστούν τα παρακάτω:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;α) Η συνάρτηση μέσης τιμής&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;β) Η συνάρτηση αυτοσυσχέτισης&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;γ) Είναι η X(t) μία Τυχαία Διαδικασία Στάσιμη με την Ευρεία &#39;Εννοια;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="400" x="520" y="-131" as="geometry" />
        </mxCell>
        <mxCell id="Ejouf2bbWhGXYELRaLHK-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=13;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFF2CC);" value="$$ m_{X}(t) $$" vertex="1">
          <mxGeometry height="20" width="37" x="677" y="-71" as="geometry" />
        </mxCell>
        <mxCell id="Ejouf2bbWhGXYELRaLHK-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=13;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFF2CC);" value="$$ R_{X}(t_1, t_2) $$" vertex="1">
          <mxGeometry height="20" width="59" x="698" y="-42" as="geometry" />
        </mxCell>
        <mxCell id="avAKGSiHxLjawOjCJzSG-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 242, 204));&quot;&gt;α) Η συνάρτηση μέσης τιμής&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="162.5" x="520" y="90" as="geometry" />
        </mxCell>
        <mxCell id="Ll2HWr-j0uhlTYZwJ6z8-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;" value="$$ m_{X}(t) = E \big[ X(t) \big]&amp;nbsp; = E \big[ A \space cos ( 2 \pi f_c \space t&amp;nbsp; +&amp;nbsp; \Theta) \big]&amp;nbsp;&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; m_{X}(t)&amp;nbsp;= \int_{-\infty}^{+\infty} A \space cos ( 2 \pi f_c \space t&amp;nbsp; +&amp;nbsp; \theta) \space&amp;nbsp; f_{\Theta}(\theta) \space d \theta&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; m_{X}(t) =&amp;nbsp;&amp;nbsp;\int_{0}^{ 2 \pi} A \space cos ( 2 \pi f_c \space t&amp;nbsp; +&amp;nbsp; \theta) \space&amp;nbsp; \frac{1}{2 \pi} \space d \theta&amp;nbsp; \space \Rightarrow&amp;nbsp; \\ \\&amp;nbsp; &amp;nbsp;m_{X}(t) = \frac{A}{2 \pi}&amp;nbsp; \int_{0}^{2 \pi} cos ( 2 \pi f_c \space t&amp;nbsp; +&amp;nbsp; \theta) \space d \theta \space \Rightarrow&amp;nbsp;&amp;nbsp;&amp;nbsp;\\ \\&amp;nbsp; &amp;nbsp;m_{X}(t) = \frac{A}{2 \pi} \frac{1}{(2 \pi f_c \space t + \theta)&#39;} \Bigg[ sint(2 \pi f_c \space t + \theta) \Bigg]_{0}^{2 \pi}&amp;nbsp; &amp;nbsp;\space \Rightarrow&amp;nbsp;&amp;nbsp;&amp;nbsp;\\ \\&amp;nbsp; &amp;nbsp;m_{X}(t) = \frac{A}{2 \pi}&amp;nbsp;&amp;nbsp;\Bigg[ sint(2 \pi f_c \space t + \theta) \Bigg]_{0}^{2 \pi}&amp;nbsp; \space \Rightarrow&amp;nbsp;&amp;nbsp;&amp;nbsp;\\ \\&amp;nbsp; &amp;nbsp;m_{X}(t) = \frac{A}{2 \pi} \big[ sin (2 \pi f_c \space t + 2 \pi) -&amp;nbsp; sin (2 \pi f_c \space t)&amp;nbsp;\big]$$" vertex="1">
          <mxGeometry height="330" width="300" x="600.64" y="130.72" as="geometry" />
        </mxCell>
        <mxCell id="Ll2HWr-j0uhlTYZwJ6z8-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 242, 204));&quot;&gt;β) Η συνάρτηση αυτοσυσχέτισης&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="180" x="520" y="685" as="geometry" />
        </mxCell>
        <mxCell id="r2MGm4R-RNyapM4FAMhP-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;" value="$$ R_{X}(t_1, t_2)&amp;nbsp;&amp;nbsp;\equiv R_{XX}(t_1, t_2) = E \big[ X(t_1) \cdot X(t_2) \big] \space \Rightarrow \\ \\ R_{X}(t_1, t_2) = E \big[&amp;nbsp; A \space cos (2 \pi f_c \space t_1&amp;nbsp; +&amp;nbsp; \Theta) \cdot A \space cos (2 \pi f_c \space t_2&amp;nbsp; +&amp;nbsp; \Theta)&amp;nbsp;\big]&amp;nbsp; \space \Rightarrow \\ \\ R_{X}(t_1, t_2) = A^2 \space E \big[ cos (2 \pi f_c \space t_1&amp;nbsp; +&amp;nbsp; \Theta)&amp;nbsp; \cdot cos (2 \pi f_c \space t_2&amp;nbsp; +&amp;nbsp; \Theta)&amp;nbsp;&amp;nbsp;\big]&amp;nbsp; \space \Rightarrow \\ \\ $$" vertex="1">
          <mxGeometry height="140" width="330" x="544.12" y="716.19" as="geometry" />
        </mxCell>
        <mxCell id="EGY4ukvOYz4kIArN17H7-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#80FF00);" value="$$ cos(A) \cdot cos(B) = \frac{1}{2} \cdot \big[ cos (A + B) +&amp;nbsp; cos (A - B) \big]&amp;nbsp;$$" vertex="1">
          <mxGeometry height="40" width="280" x="506" y="860" as="geometry" />
        </mxCell>
        <mxCell id="EGY4ukvOYz4kIArN17H7-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;fontColor=light-dark(#000000,#80FF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="*" vertex="1">
          <mxGeometry height="20" width="20" x="846.12" y="796.19" as="geometry" />
        </mxCell>
        <mxCell id="EGY4ukvOYz4kIArN17H7-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;fontColor=light-dark(#000000,#80FF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="*" vertex="1">
          <mxGeometry height="20" width="20" x="482" y="858" as="geometry" />
        </mxCell>
        <mxCell id="EGY4ukvOYz4kIArN17H7-4" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#000000,#80FF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="40" width="284" x="502" y="860" as="geometry" />
        </mxCell>
        <mxCell id="pTPoPWQcqBwmXn4fMx1k-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#80FF00);" value="$$ sin{(2 \pi f_c \space t)} =&amp;nbsp; sin{(2 \pi f_c \space t + k \cdot 2 \pi)} \space \text{&amp;nbsp; &amp;nbsp;where } \space k \in&amp;nbsp; \mathbb{Z} $$" vertex="1">
          <mxGeometry height="20" width="260" x="487.33" y="493.84" as="geometry" />
        </mxCell>
        <mxCell id="pTPoPWQcqBwmXn4fMx1k-2" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#000000,#80FF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="40" width="284" x="478.15" y="483.84000000000003" as="geometry" />
        </mxCell>
