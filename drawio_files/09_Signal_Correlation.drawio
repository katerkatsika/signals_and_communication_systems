        <mxCell id="i3AW0nWkMbO31t3JaYJ--1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;" value="$$ m_{X}(t)&amp;nbsp; = \frac{A}{2 \pi} \cdot 0 \space \Rightarrow \space m_{X}(t)&amp;nbsp; =&amp;nbsp; 0 $$" vertex="1">
          <mxGeometry height="40" width="190" x="696.59" y="560" as="geometry" />
        </mxCell>
