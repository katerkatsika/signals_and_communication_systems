        <mxCell id="Bl2zOD2f_C1R0rvK7kQ3-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Total Signal Power of AM signal&lt;div&gt;Ολική Ισχύς του διαμορφωμένου κατά πλάτος (ΑΜ) σήματος&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="337.31" x="1010" y="1819.88" as="geometry" />
