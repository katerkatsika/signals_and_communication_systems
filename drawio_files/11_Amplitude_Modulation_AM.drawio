        <mxCell id="XIdpNQqcy193KgxfNimC-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Αναλύουμε το σήμα στις συνιστώσες του" vertex="1">
          <mxGeometry height="30" width="220" x="270" y="520" as="geometry" />
        </mxCell>
        <mxCell id="XIdpNQqcy193KgxfNimC-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ y(t) =&amp;nbsp; A_c \cdot cos (\omega_c \space t)&amp;nbsp;&amp;nbsp;+ \mu \cdot A_c \cdot cos(\omega_m \space t) \cdot cos (\omega_c \space t) $$" vertex="1">
          <mxGeometry height="30" width="311.25" x="456.88" y="570" as="geometry" />
        </mxCell>
        <mxCell id="XIdpNQqcy193KgxfNimC-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Ξέρουμε από την τριγωνομετρία:" vertex="1">
          <mxGeometry height="30" width="186.88" x="270" y="640" as="geometry" />
        </mxCell>
        <mxCell id="XIdpNQqcy193KgxfNimC-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ 2 \space cosA \cdot cosB = cos(A+B) + cos(A - B) $$" vertex="1">
          <mxGeometry height="30" width="234.21" x="507.6" y="620" as="geometry" />
        </mxCell>
        <mxCell id="XIdpNQqcy193KgxfNimC-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Οπότε:" vertex="1">
          <mxGeometry height="30" width="47.5" x="266.45" y="790" as="geometry" />
        </mxCell>
        <mxCell id="XIdpNQqcy193KgxfNimC-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ y(t) =&amp;nbsp; A_c \cdot cos (\omega_c \space t)&amp;nbsp;&amp;nbsp;+ \frac{\mu \cdot A_c}{2} \cdot cos[(\omega_c - \omega_m \space) t]&amp;nbsp; +&amp;nbsp;&amp;nbsp;\frac{\mu \cdot A_c}{2} \cdot&amp;nbsp;cos [(\omega_c +\omega_m) \space t] $$" vertex="1">
          <mxGeometry height="30" width="410" x="400.2" y="790" as="geometry" />
        </mxCell>
        <mxCell id="XIdpNQqcy193KgxfNimC-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FF66FF);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;Carrier signal&lt;/div&gt;&lt;div&gt;Το Φέρον σήμα&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="100" x="436.72999999999996" y="846.2400000000001" as="geometry" />
        </mxCell>
        <mxCell id="XIdpNQqcy193KgxfNimC-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#00FFFF);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Upper SideBand signal (USB)" vertex="1">
          <mxGeometry height="30" width="117.28" x="541.37" y="847.25" as="geometry" />
        </mxCell>
        <mxCell id="XIdpNQqcy193KgxfNimC-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#80FF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Lower SideBand signal (LSB)" vertex="1">
          <mxGeometry height="30" width="133.75" x="678.7199999999999" y="846.24" as="geometry" />
        </mxCell>
        <mxCell id="XIdpNQqcy193KgxfNimC-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&#39;Το φασματικό περιεχόμενο αυτού του διαμορφωμένου σήματος αποτελείται από 3 συνιστώσες συχνότητας (βλ. και το σχετικό σχήμα που ακολουθεί)." vertex="1">
          <mxGeometry height="30" width="434.27" x="266.46" y="910" as="geometry" />
        </mxCell>
        <mxCell id="K-9flfZC4VT99V9pdnl2-518" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ y(t) =&amp;nbsp; A_c \cdot cos (\omega_c \space t)&amp;nbsp;&amp;nbsp;+ \frac{\mu \cdot A_c}{2} \cdot cos[(\omega_c - \omega_m \space) t]&amp;nbsp; +&amp;nbsp;&amp;nbsp;\frac{\mu \cdot A_c}{2} \cdot&amp;nbsp;cos [(\omega_c +\omega_m) \space t] $$" vertex="1">
          <mxGeometry height="30" width="410" x="262.46" y="1650" as="geometry" />
        </mxCell>
        <mxCell id="W8t0KX0g4pc9EwFIiq7j-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ P_c = \frac{A^2_c}{2} $$" vertex="1">
          <mxGeometry height="40.94" width="60.71" x="266.46" y="1697.39" as="geometry" />
        </mxCell>
        <mxCell id="W8t0KX0g4pc9EwFIiq7j-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ P_{LSB} = \frac{1}{2} \cdot \left( \frac{\mu A_c}{2} \right)^2&amp;nbsp; = \frac{1}{8} \cdot \mu^2 A^2_c$$" vertex="1">
          <mxGeometry height="40.94" width="183.93" x="267.37" y="1741.61" as="geometry" />
        </mxCell>
        <mxCell id="W8t0KX0g4pc9EwFIiq7j-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ P_{USB} = \frac{1}{2} \cdot \left( \frac{\mu A_c}{2} \right)^2&amp;nbsp; = \frac{1}{8} \cdot \mu^2 A^2_c$$" vertex="1">
          <mxGeometry height="40.94" width="183.93" x="267.37" y="1783.43" as="geometry" />
        </mxCell>
        <mxCell id="W8t0KX0g4pc9EwFIiq7j-4" parent="1" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;legacyAnchorPoints=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="72.44" width="20" x="474.4" y="1748" as="geometry" />
        </mxCell>
        <mxCell id="W8t0KX0g4pc9EwFIiq7j-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ P_{SB} = 2 \cdot \frac{1}{8} \cdot \mu^2 A^2_c =&amp;nbsp; \frac{1}{4} \cdot \mu^2 A^2_c$$" vertex="1">
          <mxGeometry height="40.94" width="183.93" x="500.87" y="1763.75" as="geometry" />
        </mxCell>
        <mxCell id="W8t0KX0g4pc9EwFIiq7j-6" parent="1" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;legacyAnchorPoints=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="140.7" width="20" x="710.15" y="1698.09" as="geometry" />
        </mxCell>
        <mxCell id="W8t0KX0g4pc9EwFIiq7j-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ P_{total} \equiv P_{AM} = P_C + P_{LSB} + P_{USB} \space \Rightarrow \\ \\ P_{AM} = P_C + P_{SB}&amp;nbsp;= \frac{A^2_c}{2} +&amp;nbsp; \frac{1}{4} \cdot \mu^2 A^2_c&amp;nbsp; \space \Rightarrow \\ \\ P_{AM} =&amp;nbsp; \frac{A^2_c}{2} \space \big[ 1 + \frac{\mu^2}{2}&amp;nbsp; \big] \space \Rightarrow \\ \\ P_{AM} = P_c \space \big[ 1 + \frac{\mu^2}{2}&amp;nbsp; \big]&amp;nbsp;&amp;nbsp;&amp;nbsp;$$" vertex="1">
          <mxGeometry height="163.24" width="232.39" x="760.12" y="1691.6799999999998" as="geometry" />
        </mxCell>
        <mxCell id="W8t0KX0g4pc9EwFIiq7j-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=13;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$&amp;nbsp; \omega_c \space&amp;nbsp; \text{, } \space \omega_c - \omega_m&amp;nbsp; \space&amp;nbsp; \text{, } \space \omega_c + \omega_m$$" vertex="1">
          <mxGeometry height="20" width="140" x="456.88" y="954" as="geometry" />
        </mxCell>
