        <mxCell id="R4voIChM5eb4rppABvEN-17" parent="1" style="shape=waypoint;sketch=0;fillStyle=solid;size=6;pointerEvents=1;points=[];fillColor=none;resizable=0;rotatable=0;perimeter=centerPerimeter;snapToPoint=1;strokeWidth=3;strokeColor=light-dark(#000000,#FFFF00);movable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
