        <mxCell id="AcCfeXOkm8h9tr9LFkKo-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontFamily=Lucida Console;" value="&lt;font&gt;$$ P&#39;&#39;_{ΑΜ}&amp;nbsp; = P_c&amp;nbsp; + P_{LSB}&amp;nbsp; =&amp;nbsp; 0.04&amp;nbsp; +&amp;nbsp; 1.44 \space \text{ [Watt]} \space \Rightarrow \\ \\&amp;nbsp; P&#39;&#39;_{ΑΜ}&amp;nbsp; = 1.48&amp;nbsp; \space \text{ [Watt]} $$&lt;/font&gt;" vertex="1">
