        <mxCell id="du2FoIvlY0kdq7H4F46n-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ y(t) = A&#39; \cdot cos (\omega_c \space t) $$" vertex="1">
          <mxGeometry height="20" width="140" x="240" y="260" as="geometry" />
        </mxCell>
        <mxCell id="du2FoIvlY0kdq7H4F46n-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ y(t) = \big[ A_c + m(t) \big] \cdot cos (\omega_c \space t) $$" vertex="1">
          <mxGeometry height="20" width="171.25" x="247.5" y="300" as="geometry" />
        </mxCell>
        <mxCell id="du2FoIvlY0kdq7H4F46n-9" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#000000,#00FFFF);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="40" width="171.25" x="247.5" y="290" as="geometry" />
        </mxCell>
        <mxCell id="du2FoIvlY0kdq7H4F46n-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ y(t) = \big[ A_c + m(t) \big] \cdot cos (\omega_c \space t)&amp;nbsp; \space \Rightarrow \\ \\ y(t) = \big[ A_c + A_m \cdot cos(\omega_m \space t) \big] cos (\omega_c \space t)&amp;nbsp; \space \Rightarrow \\ \\ y(t) =A_c&amp;nbsp; \big[ 1 + \frac{A_m}{A_c} \cdot cos(\omega_m t)&amp;nbsp; \big] cos (\omega_c \space t)&amp;nbsp; \space \Rightarrow \\ \\ y(t) = A_c&amp;nbsp; \big[ 1 + \mu \cdot cos(\omega_m t)&amp;nbsp; \big] cos (\omega_c \space t)$$" vertex="1">
          <mxGeometry height="190" width="250" x="490" y="250" as="geometry" />
        </mxCell>
        <mxCell id="du2FoIvlY0kdq7H4F46n-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFF00);" value="$$ \mu = \frac{A_m}{A_c} \space \text{: modulation index / δείκτης διαμόρφωσης} $$" vertex="1">
          <mxGeometry height="40" width="280" x="472.5" y="440" as="geometry" />
        </mxCell>
        <mxCell id="XIdpNQqcy193KgxfNimC-1" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#000000,#FFFF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
