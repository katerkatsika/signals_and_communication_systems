          <mxGeometry height="117.28" width="20" x="585.3699999999999" y="772" as="geometry" />
        </mxCell>
        <mxCell id="W8t0KX0g4pc9EwFIiq7j-10" parent="1" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;rotation=270;strokeColor=light-dark(#000000,#80FF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
