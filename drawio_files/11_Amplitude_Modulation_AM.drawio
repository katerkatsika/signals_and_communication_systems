        <mxCell id="yNSesIgI41wcg7y-2SKS-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#000000,#FFF2CC);" value="Δίνεται ένα σήμα πληροφορίας:" vertex="1">
          <mxGeometry height="30" width="180" x="-270" y="80" as="geometry" />
        </mxCell>
        <mxCell id="yNSesIgI41wcg7y-2SKS-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#000000,#FFF2CC);" value="Όπου f&lt;sub&gt;1&lt;/sub&gt; = 3000 Hz και f&lt;sub&gt;2&lt;/sub&gt; = 4000 Hz. Να εξεταστεί αν μπορεί να δημιουργηθεί ένα σήμα DSB-AM-SC με φέρον στη συχνότητα f&lt;sub&gt;c&lt;/sub&gt;&amp;nbsp;με τη χρήση ενός μόνο μη γραμμικού στοιχείου με συνάρτηση εισόδου y = x&lt;sup&gt;2&lt;/sup&gt;, όπου ως είσοδος τίθεται το άθροισμα:&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;Να υπολογιστεί το φάσμα του σήματος στην έξοδο του μη γραμμικού στοιχείου και να σχεδιαστεί το φάσμα πλάτους του X(f), για&amp;nbsp; f&lt;sub&gt;c&lt;/sub&gt; = 30 kHz. Μπορεί να δημιουργηθεί το επιθυμητό σήμα χωρίς τη χρήση ισοσταθμισμένου διαμορφωτή, και αν ναι, πως;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="159.07" width="460" x="-270" y="153.47" as="geometry" />
        </mxCell>
        <mxCell id="yNSesIgI41wcg7y-2SKS-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#000000,#FFF2CC);" value="$$ m(t) =&amp;nbsp; cos (2 \pi f_1 \space t) + cos (2 \pi f_2 \space t) $$&amp;nbsp;" vertex="1">
          <mxGeometry height="20" width="160" x="-130" y="126.94" as="geometry" />
