        <mxCell id="6wVEWr5bDwdT7-FuY9W5-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ u(t) =&amp;nbsp; 20 \cdot cos(2 \pi f_c \space t)&amp;nbsp;&amp;nbsp;+ 2 \space cos(2 \pi f_1 \space t) \cdot cos(2 \pi f_c \space t)&amp;nbsp;&amp;nbsp;+ 10 \space cos(2 \pi f_2 \space t)&amp;nbsp; \cdot cos(2 \pi f_c \space t) $$" vertex="1">
