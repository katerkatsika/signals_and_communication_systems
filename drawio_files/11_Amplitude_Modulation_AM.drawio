        <mxCell id="f28mk3__AtHxcrfzDIpK-24" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#FFFFFF);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font face=&quot;Lucida Console&quot;&gt;$$ y(t) =&amp;nbsp; \big[ cos (2 \pi f_1 \space t) + cos (2 \pi f_2 \space t) + cos ( 2 \pi f_c \space t ) \big] \cdot \big[ cos (2 \pi f_1 \space t)&amp;nbsp; + cos (2 \pi f_2 \space t)&amp;nbsp; + cos (2 \pi f_c \space t) \big]&amp;nbsp; \space \Rightarrow $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="510" x="-264.19" y="565" as="geometry" />
        </mxCell>
        <mxCell id="f28mk3__AtHxcrfzDIpK-25" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#FFFFFF);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font face=&quot;Lucida Console&quot;&gt;$$ Y(f) = F \big[ cos (2 \pi f_1 \space t) + cos (2 \pi f_2 \space t) + cos ( 2 \pi f_c \space t ) \big]&amp;nbsp; \space * \space F \big[ cos (2 \pi f_1 \space t)&amp;nbsp; + cos (2 \pi f_2 \space t)&amp;nbsp; + cos (2 \pi f_c \space t) \big]&amp;nbsp; \space \Rightarrow $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="535.81" x="-265.81" y="800" as="geometry" />
        </mxCell>
        <mxCell id="f28mk3__AtHxcrfzDIpK-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#FFFFFF);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font face=&quot;Lucida Console&quot;&gt;$$ Y(f) = \frac{1}{2} \big[ \delta (f - f_1) + \delta (f + f_1) + \delta (f - f_2) + \delta (f + f_2) + \delta (f - f_c) + \delta (f + f_c) \big]&amp;nbsp; \space * \\&amp;nbsp; \\&amp;nbsp; \text{&amp;nbsp; &amp;nbsp;} *&amp;nbsp; \space \frac{1}{2}&amp;nbsp; \big[ \delta (f - f_1)&amp;nbsp; + \delta (f + f_1) + \delta (f - f_2) + \delta (f + f_2) + \delta (f - f_c) + \delta (f + f_c)&amp;nbsp; \big]&amp;nbsp; \space \Rightarrow $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="456.52" x="-236.87999999999997" y="850" as="geometry" />
        </mxCell>
