        <mxCell id="f28mk3__AtHxcrfzDIpK-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#FFFFFF);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font face=&quot;Lucida Console&quot;&gt;$$ y(t) =&amp;nbsp; \big[ m(t) + cos ( 2 \pi f_c \space t ) \big] \cdot \big[ m(t) + cos (2 \pi f_c \space t) \big]&amp;nbsp; \space \Rightarrow $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="321.62" x="-170" y="522" as="geometry" />
        </mxCell>
        <mxCell id="f28mk3__AtHxcrfzDIpK-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#FFFFFF);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font face=&quot;Lucida Console&quot;&gt;$$ y(t) =&amp;nbsp; x(t) \cdot z(t)&amp;nbsp; \space \text{&amp;nbsp; &amp;nbsp;} \space&amp;nbsp; Y(f) = X(f) * Z(f) $$&lt;/font&gt;" vertex="1">
