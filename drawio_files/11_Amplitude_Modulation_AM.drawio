        <mxCell id="R4voIChM5eb4rppABvEN-18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Suppress the carrier by 26 dB." vertex="1">
          <mxGeometry height="30" width="151" x="-221" y="743" as="geometry" />
        </mxCell>
        <mxCell id="AcCfeXOkm8h9tr9LFkKo-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontFamily=Lucida Console;" value="&lt;font&gt;$$ 26 \space \text{[dB]} =&amp;nbsp;10 \cdot log \Bigg( \frac{P_c}{P&#39;_c} \Bigg) \space \Rightarrow \space&amp;nbsp; log \Bigg( \frac{P_c}{P&#39;_c} \Bigg) = 2.6&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; \frac{P_c}{P&#39;_c} = 10^{2.6} \space \Rightarrow \space P&#39;_c = \frac{P_c}{10^{2.6}} = \frac{16}{10^{2.6}} \space \Rightarrow \space P&#39;_c = 0.04 \space \text{ [W]}$$&lt;/font&gt;" vertex="1">
