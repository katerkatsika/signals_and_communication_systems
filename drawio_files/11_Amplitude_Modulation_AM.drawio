  <diagram id="6m6aWOon-neZCj5CwLV6" name="Exercise 5">
    <mxGraphModel dx="1454" dy="959" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="823BWQ9iJeHn6GCm0yLJ-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#000000,#FFF2CC);" value="Πομπός AM DSB - LC (ή DSB - ΤC) εκπέμπει σήμα ισχύος 24 W όταν διαμορφωθεί με m = 100%.&lt;div&gt;&amp;nbsp;&lt;div&gt;Να προσδιοριστεί η ισχύς εκπομπής όταν το βάθος διαμόρφωσης μειωθεί στο 60%, καταπιεσθεί μία πλευρική ζώνη και το φέρον ελαττωθεί κατά 26 dB.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="520" x="-240" y="-80" as="geometry" />
        </mxCell>
        <mxCell id="d9tGBF4WzEiBKR1h10Y5-1" edge="1" parent="1" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=none;endFill=0;strokeColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="">
          <mxGeometry relative="1" width="80" as="geometry">
            <Array as="points" />
            <mxPoint x="-238.86" as="sourcePoint" />
            <mxPoint x="842.3100000000001" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d9tGBF4WzEiBKR1h10Y5-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#000000,#FFFF00);" value="AM DSB - LC --&amp;gt; Amplitude Modulation Double SideBand&amp;nbsp; -&amp;nbsp; Large Carrier&lt;div&gt;ή AM DSB - ΤC --&amp;gt;&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;Amplitude Modulation&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Double SideBand -&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;Transmitted Carrier&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40.98" width="417.1" x="-150.07" y="-170" as="geometry" />
        </mxCell>
        <mxCell id="d9tGBF4WzEiBKR1h10Y5-3" edge="1" parent="1" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;strokeColor=light-dark(#000000,#FFFF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="">
          <mxGeometry relative="1" width="80" as="geometry">
            <Array as="points" />
            <mxPoint x="-110" y="-80" as="sourcePoint" />
            <mxPoint x="-60" y="-120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="y7eobGLi9RLKznOfQLSa-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontFamily=Lucida Console;" value="&lt;font&gt;$$ P_{AM} = 24 \space \text{ [W]} $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="96.39" x="-243.98" y="34.83" as="geometry" />
        </mxCell>
        <mxCell id="y7eobGLi9RLKznOfQLSa-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontFamily=Lucida Console;" value="&lt;font&gt;$$ \text{με } \space \mu \equiv m = 1 $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="96.39" x="-144.66" y="34.83" as="geometry" />
        </mxCell>
        <mxCell id="y7eobGLi9RLKznOfQLSa-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontFamily=Lucida Console;" value="&lt;font&gt;$$ P&#39;_{AM} = ? $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="60.29" x="-240" y="71.75" as="geometry" />
        </mxCell>
        <mxCell id="y7eobGLi9RLKznOfQLSa-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontFamily=Lucida Console;" value="&lt;font&gt;$$ \text{με } \space \mu&#39; \equiv m&#39; =0.6 $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="96.39" x="-144.58" y="73.53" as="geometry" />
        </mxCell>
        <mxCell id="y7eobGLi9RLKznOfQLSa-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font&gt;αποκοπή. μίας πλευρικής και μείωση της Pc κατά 26 dB&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="300.87" x="-52.24" y="73.53" as="geometry" />
        </mxCell>
        <mxCell id="y7eobGLi9RLKznOfQLSa-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Κατ&#39;&amp;nbsp; αρχάς υπολογίζουμε την αρχική ισχύ του φέροντος P&lt;sub&gt;c&lt;/sub&gt;" vertex="1">
          <mxGeometry height="30" width="331.48" x="-244.92999999999998" y="150" as="geometry" />
        </mxCell>
        <mxCell id="6kdGL95HwfIzQHtstH4t-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ P_{AM} = P_c \space \big[ 1 + \frac{\mu^2}{2}&amp;nbsp; \big] \space \Rightarrow&amp;nbsp; 24 = P_c \space \big[ 1 + \frac{1^2}{2}&amp;nbsp; \big] = \frac{3}{2} \cdot P_c \space \Rightarrow&amp;nbsp; \\ \\&amp;nbsp; P_c = \frac{2}{3} \cdot 24 \space \text{ [W]} \space \Rightarrow P_c = 16 \space \text{ [W]}&amp;nbsp;$$" vertex="1">
          <mxGeometry height="70" width="300.87" x="-220" y="190" as="geometry" />
        </mxCell>
