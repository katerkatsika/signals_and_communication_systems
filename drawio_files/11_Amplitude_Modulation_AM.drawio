        <mxCell id="R4voIChM5eb4rppABvEN-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontFamily=Lucida Console;" value="&lt;font&gt;$$ \mu&#39; \equiv m&#39; =0.6 $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="96.39" x="-227" y="340" as="geometry" />
        </mxCell>
        <mxCell id="R4voIChM5eb4rppABvEN-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ P&#39;_{AM} = P_c \space \big[ 1 + \frac{\mu&#39;^2}{2}&amp;nbsp; \big] \space \Rightarrow&amp;nbsp; P&#39;_{AM}&amp;nbsp;= 16 \space \big[ 1 + \frac{0.6^2}{2}&amp;nbsp; \big] = 16 \space \big[ 1 + \frac{0.36}{2}&amp;nbsp; \big]&amp;nbsp; \space \Rightarrow \\ \\&amp;nbsp; P&#39;_{AM} = (16 + 2.88 )&amp;nbsp; \space \Rightarrow \space&amp;nbsp;&amp;nbsp; P&#39;_{AM} = (16 + 2&amp;nbsp; \cdot&amp;nbsp; 1.44 )&amp;nbsp;\space \text{ [W]}&amp;nbsp;$$" vertex="1">
