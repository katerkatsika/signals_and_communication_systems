        <mxCell id="QsLFM9HES7oY4Sy4V90a-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ P_{DSB-SC} =&amp;nbsp; \frac{1}{2} \space \big[ \frac{A_c \space A_m}{2} \big]^2&amp;nbsp; + \frac{1}{2} \space \big[ \frac{A_c \space A_m}{2} \big]^2&amp;nbsp; = \big[ \frac{A_c \space A_m}{2} \big]^2 \space \Rightarrow \\ \\&amp;nbsp; P_{DSB-SC} = \frac{1}{4} \space A^2_c \space A^2_m $$" vertex="1">
