        <mxCell id="6wVEWr5bDwdT7-FuY9W5-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFF2CC);" value="$$ u(t) = \big[ 20 + 2 \space cos(3000 \pi \space t) + 10 \space cos(6000 \pi \space t) \big] \space cos(2 \pi f_c \space t) $$" vertex="1">
          <mxGeometry height="30" width="340" x="134.6" y="-202" as="geometry" />
        </mxCell>
        <mxCell id="6wVEWr5bDwdT7-FuY9W5-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="Όπου:" vertex="1">
          <mxGeometry height="30" width="39.91" x="80.09" y="-152" as="geometry" />
        </mxCell>
        <mxCell id="6wVEWr5bDwdT7-FuY9W5-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFF2CC);" value="$$ f_c = 10^5 \space \text{ Hz} $$" vertex="1">
          <mxGeometry height="30" width="67.49" x="151.65" y="-152" as="geometry" />
        </mxCell>
        <mxCell id="6wVEWr5bDwdT7-FuY9W5-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="α) (10%) Να σχεδιάσετε το φάσμα του u(t)&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;β) (5%) Να υπολογίσετε την ισχύ κάθε φασματικής συνιστώσας&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;γ) (5%) Να υπολογίστε το δείκτη διαμόρφωσης&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;δ) (10%) Να υπολογίστε το λόγο της ισχύος του σήματος πληροφορίας προς τη συνολική ισχύ.&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 242, 204));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="501.44" x="80.09" y="-102" as="geometry" />
        </mxCell>
        <mxCell id="6wVEWr5bDwdT7-FuY9W5-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ f_c = 10^5 \space \text{ Hz} = 100 \space \text{ kHz} $$" vertex="1">
          <mxGeometry height="30" width="132.47" x="137.60000000000002" y="103" as="geometry" />
        </mxCell>
        <mxCell id="6wVEWr5bDwdT7-FuY9W5-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ cos (3000 \pi \space t) = cos (\omega_1 \space t) \space \Rightarrow \space \omega_1 = 3000 \pi&amp;nbsp; \space \Rightarrow \space&amp;nbsp; 2 \pi f_1 =&amp;nbsp;&amp;nbsp;3000 \pi&amp;nbsp; \space \Rightarrow \space f_1 = 1500 \space \text{ Hz} = 1,5&amp;nbsp; \space \text{ kHz} $$" vertex="1">
          <mxGeometry height="30" width="485.96" x="130.91000000000003" y="138" as="geometry" />
        </mxCell>
        <mxCell id="6wVEWr5bDwdT7-FuY9W5-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontSize=12;fontFamily=Lucida Console;fontColor=light-dark(#000000,#FFFFFF);" value="$$ cos (6000 \pi \space t) = cos (\omega_2 \space t) \space \Rightarrow \space \omega_2 = 6000 \pi&amp;nbsp; \space \Rightarrow \space&amp;nbsp; 2 \pi f_2 =&amp;nbsp; 6000 \pi&amp;nbsp; \space \Rightarrow \space f_2 = 3000 \space \text{ Hz} = 3&amp;nbsp; \space \text{ kHz} $$" vertex="1">
          <mxGeometry height="30" width="478.19" x="129.55" y="172" as="geometry" />
        </mxCell>
        <mxCell id="6wVEWr5bDwdT7-FuY9W5-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;fontSize=12;fontColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="(1)" vertex="1">
