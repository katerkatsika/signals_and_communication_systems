          <mxGeometry height="30" width="322.66" x="-412.66" y="13" as="geometry" />
        </mxCell>
        <mxCell id="4ofnHpcCJkf01fYN7jRU-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#000000,#FFF2CC);" value="(α) Προσδιορίστε το φασματικό περιεχόμενο των σημάτων v(t) και x(t).&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(β) Προσδιορίστε τα χαρακτηριστικά του φίλτρου h(t) ώστε το σήμα x(t) να είναι το επιθυμητό DSB - SC - AM.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(γ) Προσδιορίστε την ελάχιστη τιμή της f&lt;sub&gt;c&lt;/sub&gt; η οποία επιτρέπει στο σύστημα να λειτουργήσει με τα επιθυμητά αποτελέσματα. Τι θα συμβεί σε περίπτωση που η f&lt;sub&gt;c&lt;/sub&gt; είναι μικρότερη από την τιμή αυτή;&lt;/div&gt;" vertex="1">
          <mxGeometry height="128" width="491.29" x="-401.29" y="52" as="geometry" />
        </mxCell>
        <mxCell id="VPJ4bJLH27oDah-WJd9g-1" edge="1" parent="1" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=none;endFill=0;strokeColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="">
          <mxGeometry relative="1" width="80" as="geometry">
            <Array as="points" />
            <mxPoint x="-440" y="200" as="sourcePoint" />
            <mxPoint x="641.1700000000001" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VPJ4bJLH27oDah-WJd9g-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#FFFFFF);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font face=&quot;Lucida Console&quot;&gt;$$ v(t) = m(t) \space \big[ \alpha_1 \cdot cos (2 \pi f_c \space t)&amp;nbsp; + \alpha_2 \cdot cos^2 (2 \pi f_c \space t)\big] $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="57.81" width="265.96" x="-377.29" y="268.02" as="geometry" />
        </mxCell>
        <mxCell id="VPJ4bJLH27oDah-WJd9g-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=light-dark(#000000,#FFFFFF);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font face=&quot;Lucida Console&quot;&gt;$$ V(f) = F \big[ v(t) \big] = F \big[&amp;nbsp; \frac{\alpha_2}{2} \cdot m(t)&amp;nbsp; + \alpha_1 \cdot m(t) \cdot cos (2 \pi f_c \space t) + \frac{\alpha_2}{2} \cdot m(t) \cdot cos (4 \pi f_c \space t)&amp;nbsp; \big]&amp;nbsp; \space \Rightarrow $$&lt;/font&gt;" vertex="1">
