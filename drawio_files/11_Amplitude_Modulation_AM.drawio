        <mxCell id="kWExpHTCGDjrwwQGbD2X-47" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#000000,#00FFFF);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="120" width="475" x="19.09" as="geometry" />
        </mxCell>
        <mxCell id="kWExpHTCGDjrwwQGbD2X-42" parent="1" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#000000,#FFFF00);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="" vertex="1">
          <mxGeometry height="80" width="475" x="45" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="80baBW2QdQ6sLXJQkXic-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#000000,#FFF2CC);" value="Να βρεθεί μία έκφραση και να σχεδιαστεί το φάσμα του διαμορφωμένου κατά ΑΜ σήματος όταν το σήμα πληροφορίας είναι:" vertex="1">
          <mxGeometry height="30" width="410" x="20" y="200" as="geometry" />
        </mxCell>
        <mxCell id="80baBW2QdQ6sLXJQkXic-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#000000,#FFF2CC);" value="Να χρησιμοποιηθεί φέρουσα κυματομορφή με Α&lt;sub&gt;c&lt;/sub&gt; = 2 και f&lt;sub&gt;c&lt;/sub&gt; = 15 Hz ενώ a = 1 και f&lt;sub&gt;m&lt;/sub&gt; = 1 kHz." vertex="1">
          <mxGeometry height="30" width="410" x="20" y="290" as="geometry" />
        </mxCell>
        <mxCell id="80baBW2QdQ6sLXJQkXic-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#000000,#FFF2CC);" value="$$ m(t) = \alpha \cdot cos (2 \pi f_m t) $$&amp;nbsp;" vertex="1">
          <mxGeometry height="20" width="130" x="160" y="253" as="geometry" />
        </mxCell>
        <mxCell id="8zkkfu47RGzddObc3UZF-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="$$ x(t) = \big[ A_c + m(t) \big] \cdot cos (2 \pi f_c \space&amp;nbsp; t) $$&amp;nbsp;" vertex="1">
          <mxGeometry height="40" width="220" x="120.20000000000002" y="397" as="geometry" />
        </mxCell>
        <mxCell id="08NvoSqs2nphJALjYB3W-1" edge="1" parent="1" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;rounded=0;endArrow=none;endFill=0;strokeColor=light-dark(#000000,#FFF2CC);movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="">
          <mxGeometry relative="1" width="80" as="geometry">
            <Array as="points" />
            <mxPoint x="20" y="340" as="sourcePoint" />
            <mxPoint x="1101.17" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="08NvoSqs2nphJALjYB3W-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font face=&quot;Lucida Console&quot;&gt;$$ X(f) = F \big[ x(t) \big] = F \big\{ \big[A_c + m(t) \big] \cdot cos (2 \pi f_c \space t) \big\}&amp;nbsp; \space \Rightarrow \\ \\ X(f) = F \big [ A_c \cdot cos (2 \pi f_c \space t) \big ] + F \big [ m(t) \cdot cos(2 \pi f_c \space t) \big ] $$&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="312.81" x="68.45" y="490" as="geometry" />
        </mxCell>
        <mxCell id="iA5dAHe_CbaxxEmc9sR4-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#000000,#FFFFFF);" value="AM signal:" vertex="1">
          <mxGeometry height="30" width="62.34" x="20" y="367" as="geometry" />
        </mxCell>
        <mxCell id="iA5dAHe_CbaxxEmc9sR4-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#000000,#FFFFFF);" value="Fourier Transformation of the AM signal:" vertex="1">
          <mxGeometry height="30" width="209.91" x="20" y="450" as="geometry" />
        </mxCell>
        <mxCell id="iA5dAHe_CbaxxEmc9sR4-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Lucida Console;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;fontColor=light-dark(#000000,#FFFFFF);" value="We know the Fourier Transformation of the message signal m(t):" vertex="1">
          <mxGeometry height="30" width="330.92" x="19.09" y="590" as="geometry" />
        </mxCell>
        <mxCell id="iA5dAHe_CbaxxEmc9sR4-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;font face=&quot;Lucida Console&quot;&gt;$$ M(f) =&amp;nbsp; F \big[ m(t) \big]&amp;nbsp; = F \big[ \alpha \cdot cos (2 \pi f_m \space t)&amp;nbsp; \big]&amp;nbsp; \space \Rightarrow \\ \\ M(f) = \frac{\alpha}{2} \cdot \big [ \delta(f - f_m) + \delta (f + f_m)&amp;nbsp; \big]$$&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="250.03" x="89.28" y="630" as="geometry" />
        </mxCell>
